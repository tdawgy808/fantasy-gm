# Copy to .env.local locally. Never commit real credentials.
YAHOO_CLIENT_ID=replace_with_your_yahoo_client_id
YAHOO_CLIENT_SECRET=replace_with_your_yahoo_client_secret
YAHOO_REDIRECT_URI=https://localhost:3000/api/auth/callback/yahoo
YAHOO_LEAGUE_ID=replace_with_your_league_id
# Keep disabled until Yahoo explicitly approves Fantasy Sports API access.
YAHOO_FANTASY_API_ENABLED=false
