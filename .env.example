# Copy to .env.local locally. Never commit real credentials.
# App owner sign-in (separate from Yahoo OAuth).
APP_ORIGIN=http://localhost:3000
GM_AUTH_SECRET=replace_with_at_least_32_random_bytes_base64_encoded
GM_GITHUB_CLIENT_ID=replace_with_github_oauth_app_client_id
GM_GITHUB_CLIENT_SECRET=replace_with_github_oauth_app_client_secret
GM_OWNER_GITHUB_ID=replace_with_your_numeric_github_user_id
# Existing Yahoo integration; not needed for manual snapshots.
YAHOO_CLIENT_ID=replace_with_your_yahoo_client_id
YAHOO_CLIENT_SECRET=replace_with_your_yahoo_client_secret
YAHOO_REDIRECT_URI=https://localhost:3000/api/auth/callback/yahoo
YAHOO_LEAGUE_ID=replace_with_your_league_id
# Keep disabled until Yahoo explicitly approves Fantasy Sports API access.
YAHOO_FANTASY_API_ENABLED=false
# Optional private cross-device snapshots. Set server-side only when storage is connected.
# Vercel can provision BLOB_READ_WRITE_TOKEN, or BLOB_STORE_ID with managed OIDC.
# BLOB_READ_WRITE_TOKEN=replace_with_private_store_read_write_token
# BLOB_STORE_ID=replace_with_private_blob_store_id
